# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lbc_rider?schema=public"

PORT=3002
JWT_SECRET="change-this-to-a-long-random-secret"

# Optional admin login overrides (defaults used if not set)
ADMIN_EMAIL="admin@lbc.ph"
ADMIN_PASSWORD="admin123"
ADMIN_ID="ADM-001"
ADMIN_NAME="LBC Admin"

# Google Maps / Routes / Fleet Routing
GOOGLE_MAPS_API_KEY=""
GCP_PROJECT_ID=""

# Gemini AI assistant
GEMINI_API_KEY=""

# SonarQube / SonarCloud (for local scans: npm run sonar)
# Create the project first at https://sonarcloud.io/projects/create, then copy keys from
# Project → Administration → General Settings (project key) and
# https://sonarcloud.io/account/organizations (organization key).
SONAR_HOST_URL="https://sonarcloud.io"
SONAR_TOKEN=""
# Use organization KEY (lbc-rider-backend), not display name (lbc_rider_backend)
SONAR_ORGANIZATION="lbc-rider-backend"
SONAR_PROJECT_KEY="lbc-rider-backend"
